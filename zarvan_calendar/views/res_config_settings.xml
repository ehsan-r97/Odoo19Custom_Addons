<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_jalali" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.jalali</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='base']" position="after">
                <app string="Zarvan Calendar" name="zarvan_calendar" icon="fa-calendar">
                    <block title="Persian Calendar Settings" name="zarvan_settings">
                        <setting id="jalali_default_setting" string="Default Jalali Display" help="Enable Jalali calendar for new users by default.">
                            <div class="content-group">
                                <field name="jalali_default_for_new_users"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>

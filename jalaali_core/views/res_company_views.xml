<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_jalaali" model="ir.ui.view">
        <field name="name">res.company.form.jalaali</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='company_info']" position="inside">
                <field name="use_jalaali_calendar"/>
            </xpath>
        </field>
    </record>
</odoo>

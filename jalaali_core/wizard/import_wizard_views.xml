<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_jalaali_import_wizard_form" model="ir.ui.view">
        <field name="name">jalaali.import.wizard.form</field>
        <field name="model">jalaali.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Jalali Data">
                <sheet>
                    <group>
                        <group>
                            <field name="file_data"/>
                            <field name="filename"/>
                            <field name="target_model_id"/>
                            <field name="delimiter"/>
                        </group>
                        <group>
                            <field name="column_mapping" widget="json"/>
                            <field name="has_errors" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Preview Data" name="preview">
                            <field name="preview_data" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Errors" name="errors" attrs="{'invisible': [('has_errors', '=', False)]}">
                            <field name="error_message" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Parse File" type="object" name="action_parse_file" class="btn-primary"/>
                    <button string="Import" type="object" name="action_import" class="btn-success" attrs="{'invisible': [('preview_data', '=', False)]}"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_jalaali_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Jalali Data</field>
        <field name="res_model">jalaali.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_jalaali_import"
              name="Import Jalali Data"
              parent="base.menu_administration"
              action="action_jalaali_import_wizard"
              sequence="50"/>
</odoo>
